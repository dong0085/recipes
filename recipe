#!/usr/bin/env bash
# recipe — look up recipes stored as Markdown files next to this script.
#
#   recipe                  pick a recipe from a list
#   recipe <name>           show a recipe (part of the name is enough)
#   recipe new <name>       start a new recipe from the template
#   recipe edit <name>      open a recipe in your editor
#   recipe search <word>    find recipes that mention a word (e.g. an ingredient)
#   recipe list             list every recipe
#   recipe list --tag <tag> list recipes with a tag (e.g. vegetarian)
#   recipe tags             list every tag and how many recipes use it
#   recipe serve            show the recipes as a website (for your phone)
#   recipe build            build the website as plain files in _site/
#   recipe photos [name]    make photos for recipes that have none (OpenAI)
#   recipe save [name]      commit each changed recipe on its own (git), --push to publish
#   recipe log [name]       a recipe's changelog, or recent changes to the archive; -p shows edits
#   recipe diff [name]      what has changed since the last save

set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
EDITOR="${EDITOR:-nano}"

# "Banana Bread", "banana-bread.md", "recipes/banana-bread.md" -> "banana-bread"
slug() {
  echo "$*" | tr '[:upper:]' '[:lower:]' | sed -E 's#^.*/##; s/\.md$//; s/[^a-z0-9]+/-/g; s/^-|-$//g'
}

all_recipes() {
  find "$DIR" -maxdepth 1 -name '*.md' ! -name 'README.md' ! -name 'AGENTS.md' ! -name 'CLAUDE.md' -exec basename {} .md \; | sort
}

# The tags of one recipe, one per line, from its "Tags: a, b, c" line.
tags_of() {
  grep -i -m1 '^tags:' "$DIR/$1.md" | sed -E 's/^[Tt][Aa][Gg][Ss]:[[:space:]]*//' \
    | tr ',' '\n' | sed -E 's/^[[:space:]]+|[[:space:]]+$//g' | tr '[:upper:]' '[:lower:]' | grep . || true
}

with_tag() {
  local want name
  want="$(echo "$*" | tr '[:upper:]' '[:lower:]' | sed -E 's/^[[:space:]]+|[[:space:]]+$//g')"
  all_recipes | while read -r name; do
    if tags_of "$name" | grep -qxF -- "$want"; then echo "$name"; fi
  done
}

all_tags() {
  all_recipes | while read -r name; do tags_of "$name"; done | sort | uniq -c | sort -k1,1nr -k2
}

# Match glow's theme to macOS light/dark mode, which the terminal follows.
theme() {
  if defaults read -g AppleInterfaceStyle 2>/dev/null | grep -q Dark; then
    echo dark
  else
    echo light
  fi
}

show() {
  if command -v glow >/dev/null && [[ -t 1 ]]; then
    glow -p -s "$(theme)" "$DIR/$1.md"
  elif command -v glow >/dev/null; then
    glow -s "$(theme)" "$DIR/$1.md"
  else
    cat "$DIR/$1.md"
  fi
}

# Turn what the user typed into one recipe name, or fail.
find_recipe() {
  local query matches count
  query="$(slug "$@")"

  if [[ -f "$DIR/$query.md" ]]; then
    echo "$query"
    return
  fi

  matches="$(all_recipes | grep -i -- "$query" || true)"
  count="$(printf '%s' "$matches" | grep -c . || true)"

  if [[ "$count" -eq 1 ]]; then
    echo "$matches"
  elif [[ "$count" -gt 1 ]] && command -v fzf >/dev/null && [[ -t 2 ]]; then
    pick "$query"
  elif [[ "$count" -gt 1 ]]; then
    echo "Several recipes match \"$*\":" >&2
    echo "$matches" | sed 's/^/  /' >&2
    return 1
  else
    echo "No recipe matches \"$*\". Run 'recipe list' to see them all." >&2
    return 1
  fi
}

# The archive's recipe files for git: every top-level .md file except the docs.
RECIPE_FILES=(':(top,glob)*.md' ':(top,exclude)README.md' ':(top,exclude)AGENTS.md' ':(top,exclude)CLAUDE.md')

# After an edit, point at `recipe save` so the change lands in the recipe's history.
remind_save() {
  if git -C "$DIR" rev-parse --git-dir >/dev/null 2>&1 \
     && [[ -n "$(git -C "$DIR" status --porcelain -- "$1.md")" ]]; then
    echo "Changed $1. Run 'recipe save' to add it to the history." >&2
  fi
}

recipe_log() {
  local patch="" args=() a
  for a in "$@"; do
    case "$a" in
      -p|--patch|--diff) patch=1 ;;
      *) args+=("$a") ;;
    esac
  done
  if [[ ${#args[@]} -eq 0 ]]; then
    python3 "$DIR/site/history.py" log
    return
  fi
  local name
  name="$(find_recipe "${args[@]}")" || return 1
  if [[ -n "$patch" ]]; then
    git -C "$DIR" log --follow --date=short --format='%C(yellow)%ad%C(reset)  %s  %C(dim)%an%C(reset)' \
      -p --word-diff=color -- "$name.md"
  else
    python3 "$DIR/site/history.py" log "$name"
  fi
}

recipe_diff() {
  local new
  if [[ $# -eq 0 ]]; then
    git -C "$DIR" diff --word-diff=color HEAD -- "${RECIPE_FILES[@]}"
    new="$(git -C "$DIR" -c core.quotepath=false ls-files --others --exclude-standard -- "${RECIPE_FILES[@]}")"
    [[ -n "$new" ]] && { echo "New, not saved yet:"; echo "$new" | sed 's/\.md$//; s/^/  /'; }
  else
    local name
    name="$(find_recipe "$@")" || return 1
    if ! git -C "$DIR" ls-files --error-unmatch -- "$name.md" >/dev/null 2>&1; then
      echo "$name is new and not saved yet. Run 'recipe save' to add it."
    elif git -C "$DIR" diff --quiet HEAD -- "$name.md"; then
      echo "No changes to $name since the last save."
    else
      git -C "$DIR" diff --word-diff=color HEAD -- "$name.md"
    fi
  fi
  return 0
}

pick() {
  local preview="cat $DIR/{}.md"
  command -v glow >/dev/null && preview="glow -s $(theme) $DIR/{}.md"
  all_recipes | fzf --query="${1:-}" --preview="$preview" --preview-window=right,65%
}

new_recipe() {
  [[ $# -eq 0 ]] && { echo "Usage: recipe new <name>" >&2; exit 1; }
  local name="$*" file
  file="$DIR/$(slug "$name").md"
  if [[ -f "$file" ]]; then
    echo "That recipe already exists. Opening it." >&2
  else
    cat > "$file" <<EOF
# $name

Tags:

Serves:
Time:
Source:

## Ingredients

-

## Steps

1.

## Notes

EOF
  fi
  "$EDITOR" "$file"
  remind_save "$(basename "$file" .md)"
}

case "${1:-}" in
  "")
    if command -v fzf >/dev/null && [[ -t 1 ]]; then
      name="$(pick)" && show "$name"
    else
      all_recipes
    fi
    ;;
  list|ls)
    shift
    case "${1:-}" in
      "") all_recipes ;;
      -t|--tag)
        shift
        [[ $# -eq 0 ]] && { echo "Usage: recipe list --tag <tag>" >&2; exit 1; }
        matches="$(with_tag "$@")"
        if [[ -n "$matches" ]]; then
          echo "$matches"
        else
          echo "No recipe has the tag \"$*\". Run 'recipe tags' to see them all." >&2
          exit 1
        fi
        ;;
      *) echo "Usage: recipe list [--tag <tag>]" >&2; exit 1 ;;
    esac
    ;;
  tags)
    all_tags
    ;;
  serve|web)
    shift; exec python3 "$DIR/site/serve.py" "$@"
    ;;
  build)
    shift; exec python3 "$DIR/site/build.py" "$@"
    ;;
  photos|images)
    shift; exec python3 "$DIR/site/thumbnails.py" "$@"
    ;;
  new|add)
    shift; new_recipe "$@"
    ;;
  edit)
    shift; name="$(find_recipe "$@")" && "$EDITOR" "$DIR/$name.md" && remind_save "$name"
    ;;
  save|commit)
    shift; exec python3 "$DIR/site/history.py" save "$@"
    ;;
  log|history)
    shift; recipe_log "$@"
    ;;
  diff|changes)
    shift; recipe_diff "$@"
    ;;
  search|find)
    shift
    [[ $# -eq 0 ]] && { echo "Usage: recipe search <word>" >&2; exit 1; }
    grep -ril --include='*.md' --exclude='README.md' --exclude='AGENTS.md' --exclude='CLAUDE.md' -- "$*" "$DIR" | xargs -n1 basename 2>/dev/null | sed 's/\.md$//' | sort
    ;;
  -h|--help|help)
    sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    name="$(find_recipe "$@")" && show "$name"
    ;;
esac
